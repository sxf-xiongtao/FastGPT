{
  "title": "",
  "type": "object",
  "properties": {
    "fastgpt": {
      "title": "",
      "properties": {
        "feConfigs": {
          "type": "object",
          "title": "主站前端展示配置",
          "properties": {
            "switches": {
              "type": "object",
              "title": "",
              "properties": {
                "show_git": { "type": "boolean", "title": "展示 github 图标" },
                "show_openai_account": {
                  "type": "boolean",
                  "title": "展示用户可填自己的 openapi 账号"
                },
                "show_promotion": { "type": "boolean", "title": "展示邀请好友活动" }
              }
            },
            "systemTitle": { "type": "string", "title": "系统名" },
            "images": {
              "type": "object",
              "title": "",
              "properties": {
                "favicon": { "type": "image", "title": "favicon" }
              }
            },
            "openAPIDocUrl": {
              "type": "string",
              "title": "api 文档地址"
            },
            "docUrl": {
              "type": "string",
              "title": "文档地址",
              "description": "文档地址以 / 为结尾"
            },
            "chatbotUrl": { "type": "string", "title": "聊天机器人地址" },
            "limit": {
              "type": "object",
              "title": "用户使用限制",
              "properties": {
                "exportDatasetLimitMinutes": { "type": "number", "title": "导出间隔时长(分钟)" },
                "websiteSyncLimitMinuted": {
                  "type": "number",
                  "title": "站点同步使用间隔时长(分钟)"
                }
              }
            },
            "uploadFileMaxSize": {
              "type": "number",
              "title": "上传文件最大大小（M)",
              "default": 15,
              "description": "用户上传知识库时，每个文件最大是多少。放大的话，需要注意网关也要设置得够大。"
            },
            "concatMd": { "type": "textarea", "title": "联系弹窗Markdown" }
          }
        },

        "systemEnv": {
          "type": "object",
          "title": "主站系统配置",
          "properties": {
            "openapiPrefix": { "type": "string", "title": "OpenAPI 前缀" },
            "vectorMaxProcess": { "type": "number", "title": "向量训练最大进程" },
            "qaMaxProcess": { "type": "number", "title": "QA训练最大进程" },
            "pgHNSWEfSearch": {
              "type": "number",
              "title": "HNSW ef_search",
              "description": "没有特殊设置过索引的，默认 100 即可"
            }
          }
        },

        "subPlans": {
          "type": "object",
          "title": "订阅套餐",
          "properties": {
            "standard": {
              "title": "标准订阅套餐（需严格按模板填写，可修改里面的子项）",
              "type": "json",
              "default": "{}"
            },
            "extraDatasetSizePrice": {
              "type": "number",
              "title": "知识库存储费用（xx元/1000条/月）",
              "default": 0
            }
          }
        },

        "placeholder1": {
          "type": "object",
          "title": "模型配置"
        },

        "chatModels": { "type": "json" },
        "qaModels": { "type": "json" },
        "cqModels": { "type": "json" },
        "extractModels": { "type": "json" },
        "qgModels": { "type": "json" },
        "vectorModels": { "type": "json" },
        "reRankModels": { "type": "json" },
        "audioSpeechModels": { "type": "json" },
        "whisperModel": { "type": "json" }
      }
    },
    "fastgptPro": {
      "title": "",
      "properties": {
        "system": {
          "type": "object",
          "title": "关键系统配置",
          "properties": {
            "userDefaultBalance": { "type": "number", "title": "默认用户余额" },
            "teamDefaultMaxMember": {
              "type": "number",
              "title": "默认团队成员上限",
              "defaultValue": 1
            }
          }
        },
        "auth": {
          "type": "object",
          "title": "登录配置",
          "properties": {
            "googleV3Ver": {
              "type": "object",
              "title": "谷歌V3安全校验",
              "properties": {
                "clientKey": {
                  "type": "string",
                  "title": "客户端Key"
                },
                "serviceKey": { "type": "string", "title": "服务端Key" }
              }
            },
            "email": {
              "type": "object",
              "title": "邮箱配置",
              "properties": {
                "service": {
                  "type": "string",
                  "title": "邮箱服务",
                  "description": "发送邮件相关参数\n发送邮箱验证码的 code (QQ邮箱最简单）\nhttps://wx.mail.qq.com/account/index?sid=zZ1Cd4yyR2sugk5jACBGMwAA#/?tab=safety\n在上面的链接中生成对应授权码，并提供邮箱地址"
                },
                "user": {
                  "type": "string",
                  "title": "邮箱 User",
                  "description": "qq 邮箱为例，对应 qq 号"
                },
                "pass": {
                  "type": "string",
                  "title": "邮箱 Password",
                  "description": "对应 SMTP 授权码"
                }
              }
            },
            "phone": {
              "type": "object",
              "title": "手机配置",
              "properties": {
                "SNED_PHONE_ACCESSKEYID": {
                  "type": "string",
                  "title": "ACCESSKEYID",
                  "description": "阿里云短信参数\nhttps://dysms.console.aliyun.com/overview\n申请对应的签名和短信模板，提供：\nACCESSKEYID\nACCESSSECRET\n签名名称\n模板CODE，SM开头的"
                },
                "SNED_PHONE_ACCESSSECRET": { "type": "string", "title": "ACCESSSECRET" },
                "SNED_PHONE_SIGNNAME": { "type": "string", "title": "签名名称" },
                "SNED_PHONE_TEMPLATE": { "type": "string", "title": "模板CODE" }
              }
            },
            "github": {
              "type": "object",
              "title": "GitHub 配置",
              "properties": {
                "clientId": {
                  "type": "string",
                  "title": "GitHub Client ID",
                  "description": "https://github.com/settings/developers，注册一个 oauth，\nHomepage: 域名\nCallbackurl: 域名/login/provider\n提供：\nclientId: \nclientSecret:"
                },
                "secret": { "type": "string", "title": "GitHub Secret" }
              }
            },
            "google": {
              "type": "object",
              "title": "Google 配置",
              "properties": {
                "clientId": {
                  "type": "string",
                  "title": "Google Client ID",
                  "description": "![](https://oss.laf.dev/lk63dw-fastgpt/google_service_ver_key_1.png)\n![](https://oss.laf.dev/lk63dw-fastgpt/google_service_ver_key_2.png)\nhttps://www.google.com/recaptcha/about/\nclientId: \nserviceId:\n每月有免费额度，基本够用"
                },
                "secret": { "type": "string", "title": "Google Secret" }
              }
            }
          }
        },
        "pay": {
          "type": "object",
          "title": "支付配置",
          "properties": {
            "wx": {
              "type": "object",
              "title": "微信支付配置",
              "properties": {
                "WX_APPID": {
                  "type": "string",
                  "title": "appid",
                  "description": "微信支付相关材料\nhttps://pay.weixin.qq.com/index.php/core/home/login?return_url=https%3A%2F%2Fpay.weixin.qq.com%2Findex.php%2Fextend%2Femployee\n自行注册微信支付，目前需要wx扫码支付\nappid: ![](https://oss.laf.dev/lk63dw-fastgpt/appid.png)"
                },
                "WX_MCHID": {
                  "type": "string",
                  "title": "Merchant ID",
                  "description": "![](https://oss.laf.dev/lk63dw-fastgpt/wx_mchid.png)"
                },
                "WX_V3_CODE": {
                  "type": "string",
                  "title": "V3 Code",
                  "description": "![](https://oss.laf.dev/lk63dw-fastgpt/ws_v3_code.png)"
                },
                "WX_NOTIFY_URL": {
                  "type": "string",
                  "title": "Notify URL",
                  "description": "没用到，随便填个"
                },
                "WX_SERIAL_NO": {
                  "type": "string",
                  "title": "Serial Number",
                  "description": "点管理证书进去看到\n![](https://oss.laf.dev/lk63dw-fastgpt/wx_serial_no.png)"
                },
                "WX_PRIVATE_KEY": {
                  "type": "textarea",
                  "title": "Private Key",
                  "description": "按微信教程拿到这几个文件，txt打开key\n![](https://oss.laf.dev/lk63dw-fastgpt/wx_private_key.png)"
                }
              }
            }
          }
        },
        "censor": {
          "type": "object",
          "title": "内容审查",
          "properties": {
            "BAIDU_TEXT_CENSOR_CLIENTID": {
              "type": "string",
              "title": "百度安全 id",
              "description": "![](https://oss.laf.dev/lk63dw-fastgpt/baidu_censor.png)\nhttps://console.bce.baidu.com/ai/?_=1693133074333#/ai/antiporn/overview/index 注册百度安全校验账号，并创建对应应用。提供应用的 id 和 secret"
            },
            "BAIDU_TEXT_CENSOR_CLIENTSECRET": { "type": "string", "title": "百度安全 secret" }
          }
        }
      }
    }
  }
}
