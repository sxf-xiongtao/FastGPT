# 服务提供商
SSO_PROVIDER=test
# 第三方跳转地址，填写完整地址，后续会自动给带上 state
SSO_TARGET_URL=https://sso.example.com/login?client_id=xxx
# 包含协议名的主机名，本服务的外部可访问地址，不需要包含路径
# 用于向IdP提供回调地址，以确保本服务在被反代时也能够使用正确的协议和主机名
HOSTNAME=http://localhost:3030
# 开启hostname与环境变量不同时自动重定向
# REDIRECT=true

# 零跑 - leapmotor
# SSO_PROVIDER=leapmotor
# SSO_TARGET_URL=https://sso.example.com/login
# LEAPMOTOR_AUTH_URL=xxx
# LEAPMOTOR_GET_USER_INFO_URL=xxx
# LEAPMOTOR_CLIENT_ID=xxx
# LEAPMOTOR_CLIENT_SECRET=xxx
# LEAPMOTOR_REDIRECT_URI=xxx

# 中国航发 - aecc
# SSO_PROVIDER=aecc
# SSO_TARGET_URL=https://sso.example.com/CAS/login
# AECC_SERVICE_VALIDATE_URL=xxx/CAS/serviceValidate

# 河北市场监管统一用户中心 - hebamr
# SSO_PROVIDER=hebamr
# SSO_TARGET_URL=https://sso.example.com/user/login?response_type=code
# HEBAMR_APP_ID=0000000001111111
# HEBAMR_CLIENT_ID=0000000001111111
# HEBAMR_CLIENT_SECRET=ABCdefghigklmedfdfsda
# HEBAMR_AUTH_URL=https://sso.example.com/oauth2/token
# HEBAMR_GET_USER_INFO_URL=https://user.example.com/sso/user/

# 测试SAML IdP
# SSO_PROVIDER=testSaml
# SSO_TARGET_URL=https://sso.example.com/saml/login
# TEST_SAML_IDP_METADATA_URL=https://sso.example.com/saml/metadata
# TEST_SAML_IDP_CERT_PATH=/path/to/idp-cert.pem
# TEST_SAML_SP_CERT_PATH=/path/to/sp-cert.pem
# TEST_SAML_SP_KEY_PATH=/path/to/sp-key.pem

