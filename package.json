{
  "name": "fastgpt-pro",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "prepare": "husky install",
    "format": "prettier --config \"./.prettierrc.js\" --write \"./projects/**/src/**/*.{ts,tsx,scss}\"",
    "gen:theme-typings": "chakra-cli tokens FastGPT/packages/web/styles/theme.ts --out node_modules/.pnpm/node_modules/@chakra-ui/styled-system/dist/theming.types.d.ts",
    "postinstall": "pnpm gen:theme-typings",
    "test": "vitest run",
    "lint": "eslint \"**/*.{ts,tsx}\" --fix --ignore-path .eslintignore"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^2.4.1",
    "@types/node": "^20.14.2",
    "@vitest/coverage-v8": "^3.0.9",
    "husky": "^8.0.3",
    "i18next": "23.16.8",
    "lint-staged": "^13.3.0",
    "mongodb-memory-server": "^10.1.4",
    "next-i18next": "15.4.2",
    "prettier": "3.2.4",
    "react-i18next": "14.1.2",
    "vitest": "^3.0.9",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "8.56.0",
    "eslint-config-next": "14.2.26"
  },
  "resolutions": {
    "mdast-util-gfm-autolink-literal": "2.0.0"
  },
  "lint-staged": {
    "./**/**/*.{ts,tsx,scss}": [
      "pnpm format"
    ],
    "./**/**/*.{ts,tsx}": [
      "pnpm lint"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "9.15.9"
    }
  }
}
