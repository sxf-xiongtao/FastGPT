{
  "name": "fastgpt-pro",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "prepare": "husky install",
    "format": "prettier --config \"./.prettierrc.js\" --write \"./projects/**/src/**/*.{ts,tsx,scss}\"",
    "gen:theme-typings": "chakra-cli tokens FastGPT/packages/web/styles/theme.ts --out node_modules/.pnpm/node_modules/@chakra-ui/styled-system/dist/theming.types.d.ts",
    "postinstall": "sh ./scripts/postinstall.sh"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^2.4.1",
    "@types/node": "^20.13.0",
    "husky": "^8.0.3",
    "i18next": "23.10.0",
    "lint-staged": "^13.3.0",
    "next-i18next": "15.2.0",
    "prettier": "3.2.4",
    "react-i18next": "13.5.0"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0"
  },
  "lint-staged": {
    "./projects/**/**/*.{ts,tsx,scss}": "npm run format"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
